{
    "name": "@wavoip/wavoip-api",
    "version": "2.7.0",
    "license": "MIT",
    "main": "./dist/index.cjs",
    "types": "./dist/index.d.ts",
    "module": "./dist/index.mjs",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.mjs",
            "require": "./dist/index.cjs"
        },
        "./web": {
            "types": "./dist/web.d.ts",
            "import": "./dist/web.mjs",
            "require": "./dist/web.umd.js"
        },
        "./node": {
            "types": "./dist/node.d.ts",
            "import": "./dist/node.mjs",
            "require": "./dist/node.cjs"
        },
        "./react-native": {
            "types": "./dist/react-native.d.ts",
            "import": "./dist/react-native.mjs",
            "require": "./dist/react-native.cjs"
        },
        "./dist/web.umd.js": "./dist/web.umd.js"
    },
    "files": [
        "dist",
        "!dist/web.cjs",
        "!dist/node-worker.d.ts",
        "LICENSE"
    ],
    "sideEffects": false,
    "repository": {
        "type": "git",
        "url": "git+https://github.com/wavoip/wavoip-api.git"
    },
    "scripts": {
        "dev": "vite",
        "lint": "pnpm exec tsc --noEmit && pnpm exec tsc -p tsconfig.core.json && pnpm exec biome lint --fix .",
        "build": "node scripts/check-env.mjs && vite build && BUILD_FORMAT=umd vite build && node scripts/check-public-types.mjs && node scripts/check-dist-imports.mjs && node scripts/check-worker-exit.mjs",
        "prepare": "pnpm build",
        "build:pack": "pnpm pre-deploy && pnpm pack",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "pre-deploy": "pnpm lint && pnpm test && pnpm build"
    },
    "packageManager": "pnpm@10.7.1",
    "devDependencies": {
        "@alexanderolsen/libsamplerate-js": "2.1.2",
        "@biomejs/biome": "1.9.4",
        "@roamhq/wrtc": "^0.10.0",
        "@types/node": "^22.14.0",
        "@types/ws": "^8.18.1",
        "@vitest/coverage-v8": "^4.1.2",
        "happy-dom": "^20.8.9",
        "react-native-audio-api": "^0.13.6",
        "react-native-incall-manager": "^4.3.0",
        "react-native-webrtc": "^124.0.8",
        "ts-node": "^10.9.2",
        "typescript": "~5.7.2",
        "vite": "^6.2.0",
        "vite-plugin-dts": "^4.5.3",
        "vite-plugin-externalize-deps": "^0.9.0",
        "vite-plugin-static-copy": "^3.1.2",
        "vite-tsconfig-paths": "^5.1.4",
        "vitest": "^4.1.2",
        "ws": "^8.21.3"
    },
    "dependencies": {
        "socket.io-client": "^4.8.1"
    },
    "unpkg": "./dist/web.umd.js",
    "jsdelivr": "./dist/web.umd.js",
    "peerDependencies": {
        "@roamhq/wrtc": "^0.10.0",
        "react-native-webrtc": ">=124.0.0",
        "ws": "^8.0.0",
        "react-native-incall-manager": ">=4.0.0",
        "react-native-audio-api": ">=0.13.0"
    },
    "peerDependenciesMeta": {
        "@roamhq/wrtc": {
            "optional": true
        },
        "ws": {
            "optional": true
        },
        "react-native-webrtc": {
            "optional": true
        },
        "react-native-incall-manager": {
            "optional": true
        },
        "react-native-audio-api": {
            "optional": true
        }
    }
}
